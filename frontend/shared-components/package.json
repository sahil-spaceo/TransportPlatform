    "@types/react-dom": "^18.2.0",
    "@types/styled-components": "^5.1.26",
    "typescript": "^5.0.0",
    "rollup": "^3.29.0",
    "@rollup/plugin-typescript": "^11.1.0",
    "@rollup/plugin-node-resolve": "^15.2.0",
    "@rollup/plugin-commonjs": "^25.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "eslint": "^8.0.0",
