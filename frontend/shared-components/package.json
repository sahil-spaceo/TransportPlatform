{
  "name": "@flexflow/shared-components",
  "version": "1.0.0",
  "description": "FlexFlow Shared Components - Reusable UI components",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && rollup -c",
    "dev": "rollup -c -w",
